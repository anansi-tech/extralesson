# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is the point of having one. `.env*` swallowed it,
# so a fresh clone had no .env.example while CLAUDE.md and the README both told
# the reader to see it. It carries names and reasons, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
design/reference/

# Field pages are real students' handwriting: exported locally, never committed (ROUND_5 Task 3).
design/golden/field/*
!design/golden/field/README.md
calibration/results/
