#!/usr/bin/env bash
# Gate the push on the types and on the whole suite.
#
# The pre-commit hook runs the tests, and the tests cannot see code that will
# not compile: a client component that imported next/headers passed nine
# commits, every push failed on Vercel, and the site served the build before
# them for a day while "still broken" reports came in about fixes that were
# never live. A push is what deploys, so compilation is the push's gate.
#
# The commit gate runs the unit tests, which is every test that does not start
# Chrome. The browser suites are two thirds of the wall time and would teach
# people to reach for --no-verify on every commit, so they run here instead —
# once per push rather than once per commit, and still before anything deploys.
#
# Bypass with --no-verify only when you mean to.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# A push that only deletes refs checks nothing.
deleting=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] && deleting=0
done
[ "$deleting" -eq 1 ] && exit 0

echo "checking types…"
if ! pnpm tsc --noEmit -p . >/tmp/el-pre-push.log 2>&1; then
  echo "TYPES FAILED — push refused. Full output:"
  grep -vE '^\s*$' /tmp/el-pre-push.log | tail -40
  echo "(bypass with --no-verify if you know why)"
  exit 1
fi
echo "types pass"

# CHROMES, NOT CORES. Every browser suite launches its own, so what the run can
# take is memory and vitest's default is the core count — eight here, against a
# working set that wants well over a gigabyte once a few pages are open. Three
# pushes failed that way, each with a different scattered set of suites and
# never an assertion: "Hook timed out" closing a browser, "page.setContent:
# Timeout" waiting on a page that was only starved. A gate that fails for a
# reason that is not the code is the thing that teaches --no-verify.
#
# A FIXED NUMBER IS THE WRONG SHAPE, because the load is not fixed. Four was
# measured against 5 GB free and passed all 25 browser suites in 4:00; the next
# push hit the same timeouts at 3 GB, with the dev server grown. What the run
# can afford is whatever is free WHEN IT RUNS, so that is what it reads: about
# 1.5 GB per worker, between one and four. Four passed at 5 GB and two passed
# at 3 GB — in 7:41, which is the price of a gate that finishes.
#
# vitest takes the setting for the run, not per project, so the unit half is
# capped here too; the COMMIT gate is untouched and still runs wide. Off Linux
# there is no /proc/meminfo and it falls back to two, the lowest number seen to
# work here rather than a guess at another machine.
#
# OVER-BUILT, KNOWINGLY. This machine almost never has more than 3 GB spare, so
# the arithmetic has only ever chosen two. `--maxWorkers=2` would do the same
# job in one word. Left standing because replacing it costs a full push to
# prove; collapse it to a flat 2 the next time this file is opened for
# something else.
free_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)
if [ -n "$free_kb" ]; then
  workers=$(( free_kb / 1500000 ))
  [ "$workers" -lt 1 ] && workers=1
  [ "$workers" -gt 4 ] && workers=4
else
  workers=2
fi
echo "running the whole suite… (${workers} workers, $(( ${free_kb:-0} / 1024 / 1024 )) GB free)"
if ! pnpm vitest run --silent --maxWorkers="$workers" >/tmp/el-pre-push-tests.log 2>&1; then
  echo "TESTS FAILED — push refused. Full output:"
  tail -40 /tmp/el-pre-push-tests.log
  echo "(bypass with --no-verify if you know why)"
  exit 1
fi

# EVERY TEST FILE ON DISK WAS ACTUALLY RUN. The commit gate checks the same
# thing against its own half; here the whole suite ran, so the count is exact.
on_disk=$(find tests -name '*.test.ts' | wc -l | tr -d ' ')
collected=$(grep -oE 'Test Files +[0-9]+ passed \(([0-9]+)\)' /tmp/el-pre-push-tests.log \
  | grep -oE '\(([0-9]+)\)' | tr -d '()')
if [ -n "$collected" ] && [ "$on_disk" != "$collected" ]; then
  echo "TEST COLLECTION MISMATCH — push refused."
  echo "  $on_disk test files on disk, $collected collected by vitest."
  echo "  A file on disk that never runs makes a green suite mean less than it says."
  exit 1
fi
echo "tests pass ($collected files)"

# EVERY COMPARISON THE MARKER MAKES, against what it made last time, and every
# value it reads. The suite argues each comparator change from the case in front
# of it; what no case can see is the answer that USED to be marked right and now
# is not.
#
# Two halves, because one of them is not enough. The VERDICTS catch the loud
# failure — a student's answer that was accepted and now is not. They would NOT
# have caught "20-29 min" becoming twenty minus twenty-nine: both it and
# "20-29 minutes" read as -9, so they still agreed and no verdict moved. The
# READINGS catch that one, because the shape changed underneath the agreement.
#
# Either may move. Neither may move silently: update the baseline and say why.
echo "checking verdicts…"
if ! pnpm verdicts >/tmp/el-pre-push-verdicts.log 2>&1; then
  echo "VERDICTS MOVED — push refused."
  cat /tmp/el-pre-push-verdicts.log
  exit 1
fi
tail -1 /tmp/el-pre-push-verdicts.log

# WHAT THE READER PUT IN EACH BOX, against what a person said was on the page.
# The verdicts above hold the MARKER to what it decided last time; they say
# nothing about the step before it, where a photograph becomes the entries a
# student is shown and asked to check. A read that quietly stops filling a box,
# or fills it with the wrong value, changes no verdict at all: the box is simply
# empty or wrong when they hand in, and the first report of it is a lost mark.
#
# The bar is zero wrong and at most one missing, over the hand-labelled holdout
# in design/research/prefill-holdout-labels.md. REWRITTEN — the same value spelt
# another way — is reported and does not fail, until there is enough of it to
# say whether a student reading their own answer back would object.
echo "checking the prefill holdout…"
if ! pnpm eval:holdout >/tmp/el-pre-push-prefill.log 2>&1; then
  echo "PREFILL HOLDOUT FAILED — push refused."
  cat /tmp/el-pre-push-prefill.log
  echo "(bypass with --no-verify if you know why)"
  exit 1
fi
tail -2 /tmp/el-pre-push-prefill.log
