#!/usr/bin/env bash
# Gate the commit on the things that reading cannot be trusted to catch.
#
# The kill list came first, after the greps were twice run alongside `git
# commit` and read after the push. The test suite is here for the same reason
# and the same failure: `pnpm test && git commit` in one block runs the commit
# before anyone reads the output, and main went red for a commit because of it.
# Reading order is not a control; a gate is.
#
# Bypass with --no-verify only when you mean to.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^(app|lib|scripts|tests)/.*\.(ts|tsx)$' || true)

# A commit touching no code — a spec, a README, the env example — needs neither
# check, and paying nine seconds for it would teach people to reach for
# --no-verify, which costs more than it saves.
[ "${#STAGED[@]}" -eq 0 ] && exit 0

scripts/check-kill-list.sh "${STAGED[@]}" || exit 1

# The whole suite, not the staged files' tests: a change in lib/ breaks tests
# that do not name it, which is most of the ones worth catching. It runs in
# about nine seconds, which is cheaper than a red main.
echo "running tests…"
if ! pnpm vitest run --silent >/tmp/el-pre-commit.log 2>&1; then
  echo "TESTS FAILED — commit refused. Full output:"
  tail -40 /tmp/el-pre-commit.log
  echo "(bypass with --no-verify if you know why)"
  exit 1
fi

# EVERY TEST FILE ON DISK WAS ACTUALLY RUN.
#
# Vitest already fails a file it cannot parse and a file declaring no tests —
# both exit 1, both refuse the commit. What nothing checks is a file that is
# never COLLECTED: an include pattern edited, a directory renamed, a file that
# quietly stops matching. That run is green and smaller, and green-and-smaller
# is the one failure a passing suite cannot tell you about.
on_disk=$(find tests -name '*.test.ts' | wc -l | tr -d ' ')
collected=$(grep -oE 'Test Files +[0-9]+ passed \(([0-9]+)\)' /tmp/el-pre-commit.log \
  | grep -oE '\(([0-9]+)\)' | tr -d '()')
if [ -n "$collected" ] && [ "$on_disk" != "$collected" ]; then
  echo "TEST COLLECTION MISMATCH — commit refused."
  echo "  $on_disk test files on disk, $collected collected by vitest."
  echo "  A file on disk that never runs makes a green suite mean less than it says."
  exit 1
fi
echo "tests pass ($collected files)"
