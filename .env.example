# Copy to .env and fill in. Never commit real values.
#
# The six REQUIRED variables are checked at boot by lib/preflight.ts: in
# production a missing one refuses to start rather than serving a page that
# looks fine and cannot take money (ROUND_3 §1). Locally they only warn.
# Everything else is optional and says why.

# REQUIRED. Nothing works without it.
MONGODB_URI=mongodb://localhost:27017/extralesson

# REQUIRED. OpenAI key, for generation and for reading photographed working.
# Passed explicitly to the SDK, so the name is ours, not OPENAI_API_KEY.
AI_API_KEY=

# REQUIRED. HMAC key for reset tokens and session cookies. Rotating it logs
# out every student — intentional, and documented in the README.
SESSION_SECRET=

# REQUIRED. Comma-separated emails that MAY be provisioned as operators. It
# grants nothing by itself: an operator is made by `pnpm admin:provision --
# --email you@example.com`, which sends a set-password link, and the admin
# role is written to the account only when that link is claimed (ROUND_6
# Task 3). Registering one of these addresses on the public form makes an
# ordinary student. Unset, nobody can be provisioned and /admin/access, the
# fallback every automatic grant depends on, has no one to open it.
ADMIN_EMAILS=

# REQUIRED. Stripe payment link, used as a plain <a href>. No Stripe SDK.
# Unset in production, paymentLink() throws rather than render a button that
# scrolls the reader back up the page: a dead CTA that looks alive is a lost
# sale leaving no trace.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# The origin this deployment answers on — reset links, sitemap, robots.txt and
# metadataBase. Inferred from VERCEL_URL when unset, so set it explicitly for a
# custom domain or reset links point at the preview host. It must be the
# CANONICAL host: ours 308s from the apex to www, and og:image and og:url are
# resolved against this. Unset locally means http://localhost:3000.
NEXT_PUBLIC_BASE_URL=

# Outbound email — password-reset links only. Unset is a supported state: the
# link goes to the server log instead, so local development works without a
# provider.
RESEND_API_KEY=
# Defaults to the Resend sandbox sender, which needs no verified domain. Set a
# verified sender before real students.
RESEND_FROM=

# REQUIRED. Stripe webhook, checkout.session.completed only, verified with
# node:crypto — no Stripe package and no outbound call, because the signed
# payload carries everything we act on (kill list; ROUND_2_EXAMINER.md §8c).
# Unset, the endpoint rejects every delivery, which is the safe direction.
#
# ---------------------------------------------------------------------------
# POINT THE ENDPOINT AT THE HOST THAT SERVES, NOT THE ONE THAT REDIRECTS.
#
# Our domain canonicalises: https://extralesson.app answers 308 to
# https://www.extralesson.app. An endpoint registered on the redirecting host
# delivers nothing — Stripe treats any non-2xx as a failed delivery and does
# not follow the redirect, so the request never reaches the route and the
# signature is never the suspect.
#
# It is silent. No error, no rejected signature, no unmatched payment on
# /admin/access, because Payment.create runs inside a request that never
# happened. The student pays, Stripe reports success, access never appears,
# and the only trace is in Stripe's delivery list.
#
#   curl -s -o /dev/null -D - -X POST https://<host>/api/stripe/webhook -d '{}'
#
#   308 + location:  the wrong host — use the one in Location
#   400 malformed-header  the RIGHT host: the route alive, refusing an
#                         unsigned body, which is what healthy looks like
#   404              the route is not deployed
#
# Then resend the failed event and confirm a Payment row appears. Do the same
# when the LIVE endpoint is created — separate endpoint, separate URL, separate
# signing secret, and it fails the same way just as quietly.
# ---------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=

# REQUIRED. The Payment Link ids (plink_...) that sell ExtraLesson, comma
# separated. The Stripe account is shared across Anansi products, so a signed
# checkout.session.completed is not proof the money was for us: a session from
# any other link, not in payment mode, or not yet paid is acknowledged and
# logged, never granted (ROUND_6 Task 2). Empty refuses every payment — the
# safe direction, and /admin/access still shows nothing because nothing is
# written; read the deployment log for "[stripe] ... refused".
# The id is on the Payment Link's page in the Stripe dashboard, not in its URL.
STRIPE_PAYMENT_LINKS=

# DELIBERATELY UNSET, and setting it would not change which sitting is granted.
# It maps plink_id=sitting pairs, but a payment link sells access rather than a
# sitting, so which link was used says nothing about which exam anyone sits.
#
# The sitting granted is ALWAYS the one the student registered for: the student
# knows which exam they sit, and the payer often is not the student. The failure
# is asymmetric too — granting May/June to a January candidate is generous;
# granting January to a May/June candidate locks them out in February, before
# the paper they are revising for.
#
# If sitting-specific links ever exist, set this and a mapped link becomes
# EVIDENCE: a disagreement with the registration is written into the grant note
# and shows on /admin/access rather than being resolved quietly.
STRIPE_LINK_SITTINGS=
