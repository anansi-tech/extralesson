# Copy to .env. Never commit values. Rotating SESSION_SECRET signs everyone out.

# Mongo connection string; nothing works without it.
MONGODB_URI=mongodb://localhost:27017/extralesson
# OpenAI key, for generation, reading photographed working and marking.
AI_API_KEY=
# HMAC key for session cookies and reset tokens.
SESSION_SECRET=
# Comma-separated emails that MAY be provisioned as operators (pnpm admin:provision); grants nothing by itself.
ADMIN_EMAILS=
# The Stripe Payment Link the offer button opens; its metadata must carry product=extralesson.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Signing secret of the Stripe webhook endpoint on the www host; unset, every delivery is refused.
STRIPE_WEBHOOK_SECRET=
# Canonical public origin (https://www.extralesson.app); inferred from VERCEL_URL when unset.
NEXT_PUBLIC_BASE_URL=
# Resend key for reset and provisioning emails; unset, links go to the server log instead.
RESEND_API_KEY=
# Verified sender for those emails; defaults to the Resend sandbox sender.
RESEND_FROM=
